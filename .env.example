# Runtime
DEVINA_CMS_TIMEZONE=Asia/Jakarta
DEVINA_CMS_BASE_PATH=
DEVINA_CMS_STORAGE_PATH=/absolute/path/to/private/storage
DEVINA_CMS_UPLOAD_PATH=/absolute/path/to/private/storage/uploads

# SQLite default (omit DEVINA_CMS_DSN to use storage/devina-cms.sqlite)
# DEVINA_CMS_DSN=sqlite:/absolute/path/to/devina-cms.sqlite

# MySQL/MariaDB example
# DEVINA_CMS_DSN=mysql:host=127.0.0.1;dbname=devina_cms;charset=utf8mb4
# DEVINA_CMS_DB_USER=devina_cms
# DEVINA_CMS_DB_PASSWORD=change-me

# Initial setup
# DEVINA_CMS_ADMIN_EMAIL=admin@example.com
# DEVINA_CMS_ADMIN_NAME=Administrator
# DEVINA_CMS_ADMIN_PASSWORD=use-a-long-random-password

DEVINA_CMS_SESSION_NAME=devina_cms
